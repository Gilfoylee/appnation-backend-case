# Used by the *:dev scripts (copy to .env). The values below point at the docker compose
# PostgreSQL and Redis, which are published on 127.0.0.1:55432 and 127.0.0.1:56379.
# Use another PORT while the compose API is running on 3000.

# HTTP
PORT=3001
HOST=0.0.0.0
LOG_LEVEL=info
BODY_LIMIT_BYTES=32768

# Storage
DATABASE_URL=postgres://app:app@localhost:55432/generations
DB_POOL_MAX=10
REDIS_URL=redis://localhost:56379
REDIS_COMMAND_TIMEOUT_MS=200

# Business rules
DAILY_QUOTA=5
CACHE_TTL_SECONDS=600
PROVIDER_TIMEOUT_MS=3000
